    "@dispatch-plugins/remote-core": "workspace:*"
  },
  "devDependencies": {
    "@dispatch/plugin-sdk": "link:../../.dispatch-sdk",
    "@types/node": "^26.1.0",
    "@types/ssh2": "^1.15.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
